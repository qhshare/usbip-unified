@echo off
setlocal
cd /d "%~dp0.."
set "ARCH=x64"
set "NO_PUB=0"
set "BUILD_NAME=0.1.0"
for /f "tokens=2" %%V in ('findstr /b "version:" pubspec.yaml') do set "PUBSPEC_VERSION=%%V"
for /f "tokens=2 delims=+" %%V in ("%PUBSPEC_VERSION%") do set "PACKAGE_VERSION=%%V"
if "%PACKAGE_VERSION%"=="" (
  echo Error: could not read the version from pubspec.yaml.
  exit /b 1
)
if not defined BUILD_NUMBER set "BUILD_NUMBER=%PACKAGE_VERSION%"

:parse_args
if "%~1"=="" goto args_done
if /I "%~1"=="--no-pub" (
  set "NO_PUB=1"
  shift
  goto parse_args
)
if /I "%~1"=="--pub" (
  set "NO_PUB=0"
  shift
  goto parse_args
)
if /I "%~1"=="x64" (
  set "ARCH=x64"
  shift
  goto parse_args
)
if /I "%~1"=="arm64" (
  set "ARCH=arm64"
  shift
  goto parse_args
)
echo Usage: tool\package-portable.bat [x64^|arm64] [--no-pub]
exit /b 2

:args_done
if /I not "%ARCH%"=="x64" if /I not "%ARCH%"=="arm64" (
  echo Usage: tool\package-portable.bat [x64^|arm64]
  exit /b 2
)
where flutter >nul 2>nul
if errorlevel 1 (
  echo Error: Flutter SDK was not found in PATH.
  exit /b 1
)
if "%NO_PUB%"=="1" (
  if not exist ".dart_tool\package_config.json" (
    echo Error: --no-pub requires .dart_tool\package_config.json.
    echo Run "flutter pub get" once in a network-enabled environment.
    exit /b 1
  )
  echo Reusing existing Dart dependencies ^(--no-pub^); skipping pub get and cleaning generated build caches.
  if exist build rmdir /s /q build
  if exist .dart_tool\flutter_build rmdir /s /q .dart_tool\flutter_build
) else (
  echo Installing Dart dependencies...
  call flutter clean
  if errorlevel 1 exit /b 1
  call flutter pub get
  if errorlevel 1 exit /b 1
)
echo Building Windows %ARCH% portable release...
if "%NO_PUB%"=="1" (
  if /I "%ARCH%"=="arm64" (
    call flutter build windows --release --target-platform windows-arm64 --no-pub --build-name %BUILD_NAME% --build-number %BUILD_NUMBER%
  ) else (
    call flutter build windows --release --no-pub --build-name %BUILD_NAME% --build-number %BUILD_NUMBER%
  )
) else (
  if /I "%ARCH%"=="arm64" (
    call flutter build windows --release --target-platform windows-arm64 --build-name %BUILD_NAME% --build-number %BUILD_NUMBER%
  ) else (
    call flutter build windows --release --build-name %BUILD_NAME% --build-number %BUILD_NUMBER%
  )
)
if errorlevel 1 exit /b 1

set "BUILD_DIR=build\windows\%ARCH%\runner\Release"
set "SNAPSHOT=%BUILD_DIR%\data\app.so"
if not exist "%SNAPSHOT%" (
  echo Error: the Windows bundle does not contain the AOT snapshot: %SNAPSHOT%
  exit /b 1
)
for /f "usebackq delims=" %%M in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$bytes = [IO.File]::ReadAllBytes((Resolve-Path -LiteralPath '%SNAPSHOT%')); $text = [Text.Encoding]::ASCII.GetString($bytes); if ($text -match 'product no-asan') { 'product' } elseif ($text -match 'release no-asan') { 'release' }"`) do set "SNAPSHOT_MODE=%%M"
if /I not "%SNAPSHOT_MODE%"=="product" (
  echo Error: the Windows bundle AOT snapshot is not a product snapshot: %SNAPSHOT_MODE%
  echo The Windows Runner requires a product snapshot generated by the Windows release Engine.
  exit /b 1
)
for /f "usebackq delims=" %%P in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$bytes = [IO.File]::ReadAllBytes((Resolve-Path -LiteralPath '%SNAPSHOT%')); $text = [Text.Encoding]::ASCII.GetString($bytes); if ($text -match '%ARCH% windows') { 'windows' }"`) do set "SNAPSHOT_PLATFORM=%%P"
if /I not "%SNAPSHOT_PLATFORM%"=="windows" (
  echo Error: the Windows bundle AOT snapshot targets %SNAPSHOT_PLATFORM%, not Windows.
  echo Rebuild on native Windows after running "flutter clean".
  exit /b 1
)
set "SCRIPT=%BUILD_DIR%\data\flutter_assets\offline\install-windows-offline.ps1"
set "ARCHIVE=dist\usbip-unified-windows-%ARCH%-portable-%PACKAGE_VERSION%.zip"
if not exist "%SCRIPT%" (
  echo Error: the Windows bundle does not contain the offline installer script.
  exit /b 1
)
if /I "%ARCH%"=="x64" (
  for %%F in (
    "data\flutter_assets\offline\windows\x64\usbipd-win_5.3.0_x64.msi"
    "data\flutter_assets\offline\windows\x64\VC_redist.x64.exe"
    "data\flutter_assets\offline\windows\x64\USBip-0.9.8.0-x64.exe"
  ) do (
    if not exist "%BUILD_DIR%\%%~F" (
      echo Error: the Windows bundle is missing client resource: %%~F
      echo Check pubspec.yaml and rebuild Flutter from a clean tree.
      exit /b 1
    )
  )
  if exist "%BUILD_DIR%\data\flutter_assets\offline\windows\x64\client\" (
    echo Error: the Windows x64 bundle contains the legacy fixed client payload.
    echo Clean the build directory and rebuild Flutter.
    exit /b 1
  )
  for %%F in (
    "data\flutter_assets\offline\windows\x64\usbip_vhci.inf"
    "data\flutter_assets\offline\windows\x64\usbip_vhci.sys"
    "data\flutter_assets\offline\windows\x64\usbip_vhci.cat"
  ) do (
    if exist "%BUILD_DIR%\%%~F" (
      echo Error: the Windows x64 bundle contains the legacy VHCI driver: %%~F
      echo Clean the build directory and rebuild Flutter.
      exit /b 1
    )
  )
  if exist "%BUILD_DIR%\data\flutter_assets\offline\windows\x64\USBip-0.9.7.7-x64.exe" (
    echo Error: the Windows x64 bundle contains the legacy client installer.
    echo Check pubspec.yaml and rebuild Flutter from a clean tree.
    exit /b 1
  )
)

for /f "usebackq delims=" %%H in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "(Get-FileHash -Algorithm SHA256 -LiteralPath 'offline\install-windows-offline.ps1').Hash.ToLowerInvariant()"`) do set "SOURCE_HASH=%%H"
for /f "usebackq delims=" %%H in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "(Get-FileHash -Algorithm SHA256 -LiteralPath '%SCRIPT%').Hash.ToLowerInvariant()"`) do set "BUNDLE_HASH=%%H"
if /I not "%SOURCE_HASH%"=="%BUNDLE_HASH%" (
  echo Error: the bundled PowerShell script does not match the source script.
  echo Source: %SOURCE_HASH%
  echo Bundle: %BUNDLE_HASH%
  exit /b 1
)

if not exist dist mkdir dist
if exist "%ARCHIVE%" del /f /q "%ARCHIVE%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "Compress-Archive -Path '%BUILD_DIR%\*' -DestinationPath '%ARCHIVE%' -Force"
if errorlevel 1 exit /b 1

    powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; $zip = (Resolve-Path '%ARCHIVE%').Path; $temp = Join-Path ([IO.Path]::GetTempPath()) ('usbip-unified-verify-' + [guid]::NewGuid().ToString('N')); try { Expand-Archive -LiteralPath $zip -DestinationPath $temp; $snapshot = Join-Path $temp 'data\app.so'; if (-not (Test-Path -LiteralPath $snapshot -PathType Leaf)) { throw 'The archive does not contain data/app.so.' }; $text = [Text.Encoding]::ASCII.GetString([IO.File]::ReadAllBytes($snapshot)); if ($text -notmatch 'product no-asan') { throw 'The archive AOT snapshot is not a product snapshot.' }; if ($text -notmatch '%ARCH% windows') { throw 'The archive AOT snapshot does not target the requested Windows architecture.' }; $file = Join-Path $temp 'data\flutter_assets\offline\install-windows-offline.ps1'; if (-not (Test-Path -LiteralPath $file)) { throw 'The archive does not contain the offline installer script.' }; $hash = (Get-FileHash -Algorithm SHA256 -LiteralPath $file).Hash.ToLowerInvariant(); if ($hash -ne '%SOURCE_HASH%') { throw ('Archive script hash mismatch: ' + $hash) }; if ('%ARCH%' -ieq 'x64') { $required = @('data\flutter_assets\offline\windows\x64\usbipd-win_5.3.0_x64.msi','data\flutter_assets\offline\windows\x64\VC_redist.x64.exe','data\flutter_assets\offline\windows\x64\USBip-0.9.8.0-x64.exe'); foreach ($relative in $required) { $requiredFile = Join-Path $temp $relative; if (-not (Test-Path -LiteralPath $requiredFile -PathType Leaf)) { throw ('Archive is missing client resource: ' + $relative) } }; $legacyClient = Join-Path $temp 'data\flutter_assets\offline\windows\x64\client'; if (Test-Path -LiteralPath $legacyClient -PathType Container) { throw 'Archive contains the legacy fixed client payload directory.' }; foreach ($legacyDriver in @('usbip_vhci.inf','usbip_vhci.sys','usbip_vhci.cat')) { $legacyFile = Join-Path $temp ('data\flutter_assets\offline\windows\x64\' + $legacyDriver); if (Test-Path -LiteralPath $legacyFile -PathType Leaf) { throw ('Archive contains the legacy VHCI driver: ' + $legacyDriver) } }; if (Test-Path -LiteralPath (Join-Path $temp 'data\flutter_assets\offline\windows\x64\USBip-0.9.7.7-x64.exe')) { throw 'Archive contains the legacy x64 client installer.' } }; Write-Host ('Archive verified. Script SHA256: ' + $hash) } finally { if (Test-Path -LiteralPath $temp) { Remove-Item -LiteralPath $temp -Recurse -Force } }"
if errorlevel 1 exit /b 1

for /f "usebackq delims=" %%H in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "(Get-FileHash -Algorithm SHA256 -LiteralPath '%ARCHIVE%').Hash.ToLowerInvariant()"`) do set "ARCHIVE_HASH=%%H"
echo Windows portable package: %ARCHIVE%
echo Archive SHA256: %ARCHIVE_HASH%
endlocal
